pipeline {

    agent any

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'pip install -r backend\\requirements.txt'
            }
        }

        stage('Compare Models') {
            steps {
                bat 'python backend\\compare_models.py'
            }
        }

    }

    post {

        success {
            echo 'Model Promotion Pipeline Completed Successfully'
        }

        failure {
            echo 'Model Promotion Pipeline Failed'
        }

    }

}